diff --git a/hooks/hermes/rtk-rewrite/__init__.py b/hooks/hermes/rtk-rewrite/__init__.py
index 6dcf44e..15e38d8 100644
--- a/hooks/hermes/rtk-rewrite/__init__.py
+++ b/hooks/hermes/rtk-rewrite/__init__.py
@@ -4,6 +4,7 @@ All rewrite logic lives in RTK's Rust ``rtk rewrite`` command; this module
 only bridges Hermes ``pre_tool_call`` payloads to that command and fails open.
 """
 
+import os
 import shutil
 import subprocess
 import sys
@@ -71,10 +72,45 @@ def _pre_tool_call(tool_name=None, args=None, **_kwargs):
         rewritten = result.stdout.strip()
         if rewritten and rewritten != command:
             args["command"] = rewritten
+            _log_to_umc(
+                title=f"RTK Opt: {command[:50]}",
+                content=f"Original: {command}\nRewritten: {rewritten}",
+            )
     except Exception as e:
         _warn(str(e))
         return
 
 
+def _log_to_umc(title, content):
+    """Record an optional rewrite observation without blocking the terminal call."""
+    try:
+        sinapse_home = os.environ.get("SINAPSE_HOME")
+        if not sinapse_home:
+            return
+
+        write_script = os.path.join(
+            sinapse_home, "scripts", "services", "sinapse-write.py"
+        )
+        if not os.path.isfile(write_script):
+            return
+
+        subprocess.Popen(
+            [
+                sys.executable,
+                write_script,
+                "observation",
+                "--title",
+                title,
+                "--content",
+                content,
+                "--kind",
+                "execution",
+            ],
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+        )
+    except Exception:
+        pass
+
 def _warn(message):
     print(f"rtk: hermes plugin warning: {message}", file=sys.stderr)
