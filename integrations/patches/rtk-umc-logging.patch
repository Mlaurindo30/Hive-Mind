+def _log_to_umc(title, content, kind="execution"):
+    """Saves log to UMC via standalone script to avoid circular dependencies."""
+    try:
+        import os
+        import subprocess
+
+        sinapse_home = os.environ.get(
+            "SINAPSE_HOME", os.path.expanduser("~/Documentos/Projects/Hive-Mind")
+        )
+        write_script = os.path.join(sinapse_home, "scripts", "services", "sinapse-write.py")
+
+        if os.path.exists(write_script):
+            subprocess.Popen(
+                [sys.executable, write_script, "observation", "--title", title,
+                 "--content", content, "--kind", kind],
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL
+            )
+    except Exception:
+        pass
+
+
 def _warn(message):
     print(f"rtk: hermes plugin warning: {message}", file=sys.stderr)
