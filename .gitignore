# Sinapse Agent — .gitignore

# ── Vault Obsidian (LOCAL — materializado pelo install.sh, nunca commitar) ──
# Regra cega: nada do cerebro/ vai pro git. Shipped templates vivem em
# templates/vault/ (whitelisted abaixo) e são copiados pelo install.sh.
cerebro/
!templates/vault/
# Mantém o whitelist explícito (defesa em profundidade)
!templates/vault/**
cerebro/.obsidian/workspace.json
cerebro/.obsidian/workspace-mobile.json
cerebro/.trash/
cerebro.backup*
# Vault: conteúdo runtime (sessões, inbox, trabalho ativo, decisões, projetos)
cerebro/cerebelo/sessoes/
cerebro/cerebro/
cerebro/cortex/frontal/decisoes/
cerebro/cortex/frontal/projetos/
cerebro/cortex/frontal/trabalho/
cerebro/cortex/insula/
cerebro/cortex/parietal/inbox/
# Vault: neurônios individuais (gerados pelo Dream Cycle)
cerebro/cortex/temporal/**/neuronio-*.md
# Vault: projetos externos ao Hive-Mind (memória de outros repositórios)
cerebro/cortex/temporal/ComfyUI/
cerebro/cortex/temporal/OpenAlice/
cerebro/cortex/temporal/Thoth/
cerebro/cortex/temporal/agent-langgraph/
cerebro/cortex/temporal/e2e-chatbot-app-next/
cerebro/cortex/temporal/michel/
cerebro/cortex/temporal/open-design/
cerebro/cortex/temporal/openclaw-crestodian-planner-NyDaMs/

# ── Graphify output (artefatos runtime — regenerados, não commitar) ──
cerebro/graphify-out/
graphify-out/
# Cache AST do graphify (indexação por hash de arquivo)
cerebro/cortex/occipital/grafo/cache/ast/
# Bookkeeping de reindexação incremental (mtime/hash por arquivo — regenerável,
# sincronizado entre máquinas via Syncthing, não via git; ver docs/04 §4.3)
cerebro/cortex/occipital/grafo/manifest.json
cerebro/cortex/occipital/grafo/.rebuild.lock
cerebro/cortex/occipital/grafo/.pending_changes

# ── Dependências ───────────────────────────────────────────────────
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# ── Binários CR-SQLite (P8) — baixados pelo install.sh, não commitar ──
integrations/crsqlite/crsqlite.so
integrations/crsqlite/crsqlite.dylib
integrations/crsqlite/crsqlite.dll

# ── Sistema ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
# Config local de máquina (systemd user units — instalar via script)
.config/

# ── Logs ───────────────────────────────────────────────────────────
*.log
logs/
cerebro/thinking/session-logs/

# ── Runtime data ───────────────────────────────────────────────────
claude-mem/data/
integrations/rtk/target/
backups/

# ── Hermes agent local ────────────────────────────────────────────
# Unanchored on purpose: hides .hermes/ tool-state wherever it appears
# (root and elsewhere). The shipped template at
# templates/vault/tronco/infra/agentes/.hermes/ is re-included via the
# explicit negation below (found colliding via the D7 zero-to-green
# Docker test, 2026-07-04 — do not remove the negation).
.hermes/

# ── Embedded repos ─────────────────────────────────────────────────
claude-mem/
integrations/graphify/
integrations/neural-memory/
integrations/rtk/

# ── Secrets ─────────────────────────────────────────────────────────
.env
.env.*
*.secret
config/keys/
config/component-lock-backups/
.tools/

# ── Bancos de dados locais (memória pessoal — nunca commitar) ───────
hive_mind.db
hive_mind.db-*
hive_mind.db.bak
hive_mind.db.pre-crr*
hive_mind.db.pre-crr.*
*.db.bak
banco.db
ruvector.db

# ── Venvs auxiliares ─────────────────────────────────────────────────
.venv-sqlite-vec/
.pytest_cache/

# ── Pastas de ferramentas e agentes locais (não commitar) ────────────
# .claude/, .claude-flow/ and .gemini/ are unanchored on purpose: these
# tool-state directories (e.g. claude-flow's data/pending-insights.jsonl)
# appear at multiple depths in this tree (root, config/, npm/,
# scripts/capture/, ...), not just root. The shipped templates at
# templates/vault/tronco/infra/agentes/{.claude,.claude-flow,.gemini}/
# are re-included via the explicit negations below — do not remove them.
.claude/
.claude-flow/
.gemini/
/.kiro/
/.opencode/
/.swarm/
.kilo/
.mcp.json

# Re-include the shipped agent-hook templates the four unanchored
# patterns above (.claude/, .claude-flow/, .gemini/) and .hermes/ would
# otherwise also swallow at this nested path (D7 zero-to-green Docker
# test, 2026-07-04).
!templates/vault/tronco/infra/agentes/.claude/
!templates/vault/tronco/infra/agentes/.claude/**
!templates/vault/tronco/infra/agentes/.claude-flow/
!templates/vault/tronco/infra/agentes/.claude-flow/**
!templates/vault/tronco/infra/agentes/.gemini/
!templates/vault/tronco/infra/agentes/.gemini/**
!templates/vault/tronco/infra/agentes/.hermes/
!templates/vault/tronco/infra/agentes/.hermes/**

# ── Índices neurais (artefatos runtime — regenerados automaticamente) ─
hnsw_neurons.idx
hnsw_neurons.map.json
*.neuralmemory/

# ── Outputs de sessão (gerados em runtime, não fazem parte do código) ─
council_responses.txt
*.bak

# ── Arquivos temporários e de testes do workspace ────────────────────
contrarian_prompt.md
framed_question.txt
run_council.py
cerebro/WatchTest.md
cerebro/BenchTest.md
cerebro/Bench-Test.md
cerebro/BenchMark.md
cerebro/portal.canvas
cerebro/inbox/
cerebro/conflicts/
cerebro/cortex/occipital/grafo/cache

# Codex/Copilot agent hooks locais (working copies — canonico em cerebro/tronco/infra/agentes/)
.codex/hooks.json
# .github/copilot-instructions.md (canonical — committed)
.agents/

# Per-agent contract files materialized by scripts/setup/register-mcp.sh
# (canonical source: config/sinapse-agent-prompt.md)
/GEMINI.md
/CLAUDE.md

# Documents
docs/08-memoria-viva-design.md
docs/10-implementation-roadmap.md
docs/reports
docs/plans
docs/walkthrough.md
docs/06-gap-analysis.md
docs/11-knowledge-promotion-architecture.md
docs/13-slo-and-observability.md
docs/12-knowledge-implementation-plan.md
# PostScript test artifacts (ImageMagick output with bare names) — must never be tracked
/json
/os
/sys
/argparse

# Coverage artifacts (pytest-cov)
.coverage
.coverage.*
.tmp/


# ── Type-hint escape artifacts (M0: prevent reappearance of leaked Python
# typing.Path / Optional[str] / dict / etc as zero-byte files in the root).
# These are residuals from a PowerShell here-string/escape bug; they are not
# source code, and re-creating them in a fresh checkout indicates the bug is
# back. Keep this block as a tripwire.
Optional*
/Optional*
/Path
/automated
/dict*
/`assistant`)`
/dict[tuple*
# Daemon runtime state (D007+) — never committed
.hive-mind/

# ── Fase 00 (total-delivery-2026-07): artefatos gerados que nunca vao para o repo.
# Backups automaticos escritos pelo registrador de agentes ao reescrever configs:
*.hive-bak
# Arquivos de distribuicao/empacotamento (Hive-Mind.zip tinha 129 MB):
*.zip
# Auditorias de vault escritas em runtime:
.vault-audit.json
tmp_vault_audit.json
