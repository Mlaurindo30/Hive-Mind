# =============================================================================
# Crontab — Hive-Mind Integrations Auto-Update
#
# Template: __PROJECT_ROOT__ é substituído pelo caminho real na instalação.
#
# Instalação (a partir da raiz do projeto):
#   crontab -l | cat - <(sed "s|__PROJECT_ROOT__|$(pwd)|" scripts/maintenance/integrations-update.crontab) | crontab -
#
# Desinstalação:
#   crontab -l | grep -v 'integrations-update' | crontab -
#
# Agenda: 2x por semana (terça e sexta às 10:00)
# Log:     logs/integrations-update.log (dentro do projeto)
# =============================================================================

# Hive-Mind: atualização de integrações (neural-memory, rtk, graphify, claude-mem)
0 10 * * 2,5 cd __PROJECT_ROOT__ && ./scripts/maintenance/integrations-update.sh >> logs/integrations-update.log 2>&1
