# Model Gateway environment variables
#
# Mode of operation (R5). Canonical: `auto` (default — gateway via
# combined registry; falls back to legacy with explicit warning on
# failure), `on` (gateway mandatory — never falls back), `off`
# (deprecated, emits deprecation warning). Replaces the old
# `MODEL_GATEWAY_ENABLED` boolean.
MODEL_GATEWAY_MODE=auto

# Emergency bypass — calls the legacy `_legacy_call_llm_with_fallback`
# directly. Should NEVER be set as default; it is the recovery path when
# the gateway is misbehaving in production. See
# specs/model-gateway-unification.md R4/R5 and docs/14-model-gateway.md.
# HIVE_FORCE_LEGACY_LLM=false

# DEPRECATED — use MODEL_GATEWAY_MODE instead. Read only as a
# compatibility shim and emits a deprecation warning. `true` → MODE=on,
# `false` → MODE=off. Absent → MODE=auto. Will be removed in a future
# release.
# MODEL_GATEWAY_ENABLED=false

# Optional: path to a model-gateway.yaml with provider/role overrides.
# Default: config/model-gateway.yaml (auto-discovered relative to
# SINAPSE_HOME).
# MODEL_GATEWAY_CONFIG=config/model-gateway.yaml

# Backend-specific overrides for the optional `models[]` block in the
# YAML. Each backend can be enabled by starting it and uncommenting
# the corresponding lines.

LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=

LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL=

VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=

SGLANG_BASE_URL=http://localhost:30000/v1
SGLANG_MODEL=

LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=
LITELLM_MODEL=
