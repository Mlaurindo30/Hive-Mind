# ── Role-based LLM configuration ─────────────────────────────────────────────
# Roles: DREAMER (base), GRAPHIFY, VISION, SYNTHESIS.
# Inheritance: a role without its own PROVIDER+MODEL inherits Dreamer's (and
# also Dreamer's fallback). A role with its own primary uses only its own fallback.
# API keys live only in provider-level vars (GOOGLE_API_KEY etc.) — never per role.
HIVE_DREAMER_PROVIDER=
HIVE_DREAMER_MODEL=
HIVE_DREAMER_FALLBACK_PROVIDER=
HIVE_DREAMER_FALLBACK_MODEL=
HIVE_GRAPHIFY_PROVIDER=
HIVE_GRAPHIFY_MODEL=
HIVE_GRAPHIFY_FALLBACK_PROVIDER=
HIVE_GRAPHIFY_FALLBACK_MODEL=
HIVE_VISION_PROVIDER=ollama
# Requires Ollama >= 0.30. On older versions, use gemma3:4b as the vision model.
HIVE_VISION_MODEL=minicpm-v4.6:latest
HIVE_VISION_FALLBACK_PROVIDER=ollama
HIVE_VISION_FALLBACK_MODEL=gemma3:4b
# Optional dedicated OCR; the current visual runtime uses HIVE_VISION_*.
HIVE_OCR_PROVIDER=ollama
HIVE_OCR_MODEL=deepseek-ocr:latest
HIVE_SYNTHESIS_PROVIDER=
HIVE_SYNTHESIS_MODEL=
HIVE_SYNTHESIS_FALLBACK_PROVIDER=
HIVE_SYNTHESIS_FALLBACK_MODEL=
# Note: embeddings are not configured per role. The canonical global default is
# local Ollama with snowflake-arctic-embed2:latest (1024d), via OLLAMA_EMBED_MODEL.
OLLAMA_EMBED_MODEL=snowflake-arctic-embed2:latest
