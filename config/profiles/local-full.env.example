# Canonical local-full runtime contract. Copy only non-secret defaults into .env.
VECTOR_BACKEND=milvus
MODEL_GATEWAY_MODE=on
HIVE_FORCE_LEGACY_LLM=false
# local-full is self-contained: K5 roles inherit this local provider.
HIVE_DREAMER_PROVIDER=ollama
HIVE_DREAMER_MODEL=qwen2.5:3b
HIVE_KNOWLEDGE_HEALTH_MILVUS=1
MILVUS_URI=http://127.0.0.1:19530
RAGFLOW_BASE=http://127.0.0.1:9380
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
HIVE_MIND_PROFILE=local-full
