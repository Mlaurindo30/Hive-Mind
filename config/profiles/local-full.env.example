# Canonical local-full runtime contract. Copy only non-secret defaults into .env.
VECTOR_BACKEND=milvus
MODEL_GATEWAY_MODE=on
HIVE_FORCE_LEGACY_LLM=false
# local-full is self-contained: K5 roles inherit this local provider.
HIVE_DREAMER_PROVIDER=ollama
HIVE_DREAMER_MODEL=qwen2.5:3b
# Roles used directly by the Model Gateway must have primaries of their own.
# Without these entries they can resolve to an unrelated generic fallback.
HIVE_VALIDATOR_PROVIDER=ollama
HIVE_VALIDATOR_MODEL=qwen2.5:3b
HIVE_ROUTER_PROVIDER=ollama
HIVE_ROUTER_MODEL=qwen2.5:3b
HIVE_DISTILLER_PROVIDER=ollama
HIVE_DISTILLER_MODEL=qwen2.5:3b
# Graphiti needs a capable local extractor to materialize temporal
# invalidations; qwen2.5:3b is kept as the generic Dreamer model.
HIVE_GRAPHITI_PROVIDER=ollama
HIVE_GRAPHITI_MODEL=granite4.1:8b
HIVE_KNOWLEDGE_HEALTH_MILVUS=1
MILVUS_URI=http://127.0.0.1:19530
RAGFLOW_BASE=http://127.0.0.1:9380
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
HIVE_MIND_PROFILE=local-full
